@{
    ViewData["Title"] = "Escáner Facial";
}

<h2>Escáner Facial</h2>

<video id="video" width="640" height="480" autoplay></video>
<canvas id="canvas" style="display:none;"></canvas>
<br />
<button id="btnEscanear" class="btn btn-primary">Escanear Rostro</button>
<p id="resultado" class="mt-3 font-weight-bold"></p>

@section Scripts {
    <!-- ✅ Importa SweetAlert2 desde CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const resultado = document.getElementById('resultado');
        const ctx = canvas.getContext('2d');

        // ✅ Activar cámara
        navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => {
                video.srcObject = stream;
            })
            .catch(err => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error de cámara',
                    text: 'No se pudo acceder a la cámara: ' + err.message
                });
            });

        // ✅ Botón de escaneo
        document.getElementById('btnEscanear').addEventListener('click', () => {
            try {
                // Captura imagen actual del video
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                const dataUrl = canvas.toDataURL('image/jpeg');

                // ⚠️ Validar si realmente capturó algo
                if (!dataUrl || dataUrl.length < 10000) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Imagen no reconocida',
                        text: 'No se pudo capturar correctamente la imagen del rostro. Intenta nuevamente.',
                        confirmButtonText: 'Reintentar'
                    });
                    return;
                }

                // ✅ Enviar al servidor Flask
                fetch('http://127.0.0.1:5000/reconocer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ imagen: dataUrl })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.autorizado) {
                        // ✅ Rostro reconocido
                        resultado.innerText = `✅ Autorizado\nNombre: ${data.nombre}\nCI: ${data.ci}\nPabellón: ${data.pabellon}`;
                        resultado.style.color = 'green';
                        Swal.fire({
                            icon: 'success',
                            title: 'Acceso autorizado',
                            html: `<b>${data.nombre}</b><br>CI: ${data.ci}<br>Pabellón: ${data.pabellon}`,
                            confirmButtonText: 'Aceptar'
                        });
                    } else {
                        // ❌ Rostro no reconocido
                        resultado.innerText = "❌ No autorizado";
                        resultado.style.color = 'red';
                        Swal.fire({
                            icon: 'warning',
                            title: 'Rostro no reconocido',
                            text: 'Intenta nuevamente o verifica que la persona esté registrada.',
                            confirmButtonText: 'Reintentar'
                        });
                    }
                })
                .catch(err => {
                    // ⚠️ Error de conexión
                    resultado.innerText = "❌ Error en la verificación";
                    resultado.style.color = 'red';
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de conexión',
                        text: 'No se pudo contactar al servidor Flask. Asegúrate de que esté ejecutándose en el puerto 5000.',
                        confirmButtonText: 'Entendido'
                    });
                    console.error("Error:", err);
                });
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error inesperado',
                    text: 'Ocurrió un error al intentar capturar la imagen: ' + error.message
                });
            }
        });
    </script>
}
