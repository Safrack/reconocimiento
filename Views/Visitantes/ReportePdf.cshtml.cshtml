@model List<SistemaCarcel.Controllers.VisitanteReporteViewModel>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reporte de Visitantes</title>
    <style>
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #000; padding: 5px; text-align: left; }
        th { background-color: #eee; }
    </style>
</head>
<body>
    <h2>Reporte de Visitantes</h2>
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Pabellón</th>
                <th>Edad</th>
                <th>Recluso</th>
                <th>Fecha</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Id</td>
                <td>@v.Nombre</td>
                <td>@v.Pabellon</td>
                <td>@v.Edad</td>
                <td>@v.Recluso</td>
                <td>@v.Fecha</td>
            </tr>
        }
        </tbody>
    </table>
</body>
</html>
