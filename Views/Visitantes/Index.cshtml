@model IEnumerable<SistemaCarcel.Models.Visitante>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Visitantes";
}

<h1>Visitantes</h1>

<div class="row mb-3">
    <div class="col-md-3">
        <label>Pabellón</label>
        <select class="form-control" id="pabellonFilter">
            <option value="">Todos</option>
            @foreach (var pabellon in ViewBag.PabellonId as SelectList)
            {
                <option value="@pabellon.Value">@pabellon.Text</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label>Fecha Exacta</label>
        <input type="date" id="fechaExactaFilter" class="form-control" />
    </div>
    <div class="col-md-3">
        <label>Fecha Inicio</label>
        <input type="date" id="fechaInicioFilter" class="form-control" />
    </div>
    <div class="col-md-3">
        <label>Fecha Fin</label>
        <input type="date" id="fechaFinFilter" class="form-control" />
    </div>
</div>

<!-- Formulario oculto para enviar datos al servidor -->
<form id="formReporte" method="post" asp-action="GenerarReporte" asp-controller="Visitantes">
    @Html.AntiForgeryToken()
    <input type="hidden" name="data" id="dataReporte" />
</form>

<button id="generarReporte" class="btn btn-success mb-3">Generar Reporte</button>

<table class="table table-bordered table-striped" id="visitantesTable">
    <thead>
        <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Pabellón</th>
            <th>Edad</th>
            <th>Recluso Asociado</th>
            <th>Fecha/Hora</th>
        </tr>
    </thead>
    <tbody>
        @{
            int contador = 1;
            foreach (var v in Model.OrderBy(x => x.Id))
            {
                <tr data-pabellon="@v.IdPabellon" data-fecha="@v.Hora.ToString("yyyy-MM-dd")">
                    <td>@contador</td>
                    <td>@v.NombreCompleto</td>
                    <td>@v.Pabellon?.NombrePb</td>
                    <td>@v.Edad</td>
                    <td>@v.NombrePrivadoLibertad</td>
                    <td>@v.Hora.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
                contador++;
            }
        }
    </tbody>
</table>

<script>
    // Función de filtrado de filas
    function filtrar() {
        var pabellon = document.getElementById('pabellonFilter').value;
        var fechaExacta = document.getElementById('fechaExactaFilter').value;
        var fechaInicio = document.getElementById('fechaInicioFilter').value;
        var fechaFin = document.getElementById('fechaFinFilter').value;

        document.querySelectorAll('#visitantesTable tbody tr').forEach(row => {
            var rowPabellon = row.getAttribute('data-pabellon');
            var rowFecha = row.getAttribute('data-fecha');
            var mostrar = true;

            if (pabellon && rowPabellon !== pabellon) mostrar = false;
            if (fechaExacta && rowFecha !== fechaExacta) mostrar = false;
            if (fechaInicio && rowFecha < fechaInicio) mostrar = false;
            if (fechaFin && rowFecha > fechaFin) mostrar = false;

            row.style.display = mostrar ? "" : "none";
        });
    }

    // Asignar evento a los filtros
    ['pabellonFilter','fechaExactaFilter','fechaInicioFilter','fechaFinFilter'].forEach(id => {
        document.getElementById(id).addEventListener('change', filtrar);
    });

    // Evento del botón Generar Reporte
   document.getElementById('generarReporte').addEventListener('click', function () {
    var filasVisibles = Array.from(document.querySelectorAll('#visitantesTable tbody tr'))
                              .filter(r => r.style.display !== 'none');

    if(filasVisibles.length === 0){
        alert("No hay datos para generar el reporte.");
        return;
    }

    var datos = filasVisibles.map((r, index) => ({
        Id: index + 1,
        Nombre: r.cells[1].innerText,
        Pabellon: r.cells[2].innerText,
        Edad: parseInt(r.cells[3].innerText),
        Recluso: r.cells[4].innerText,
        Fecha: r.cells[5].innerText
    }));

    fetch('/Visitantes/GenerarReporte', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(datos)
    })
    .then(response => response.blob())
    .then(blob => {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = "Reporte_Visitantes.pdf";
        document.body.appendChild(a);
        a.click();
        a.remove();
    })
    .catch(err => console.error(err));
});
</script>
